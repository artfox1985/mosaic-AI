#!/bin/sh
# tools/hooks/pre-push -- Golden-Waechter (A1-A4, `cargo test --release`), aber
# NUR wenn im zu pushenden Bereich engine/src/ geaendert wurde. Andernfalls
# sofortiger Durchlass (Zeile "sonst durchlassen" im Design-Dok).
#
# Aktivierung (einmalig, siehe tools/hooks/README.md):
#   git config core.hooksPath tools/hooks
#
# Budget: < 90 s (siehe evaluations/DESIGN_conventions_as_checks.md,
# Abschnitt "Entscheid: LOKALER GIT-HOOK").
#
# Fehlalarm? git push --no-verify
#
# Git ruft pre-push mit ($1=Remote-Name, $2=Remote-URL) auf und liefert auf
# stdin eine Zeile je zu aktualisierender Ref: "<local ref> <local sha>
# <remote ref> <remote sha>".

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

ZERO_SHA="0000000000000000000000000000000000000000"
ENGINE_SRC_CHANGED=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    if [ "$local_sha" = "$ZERO_SHA" ]; then
        continue  # Ref wird geloescht -- nichts zu pruefen
    fi
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        RANGE="$local_sha"  # neuer Remote-Branch: kompletten Branch pruefen
    else
        RANGE="$remote_sha..$local_sha"
    fi
    if [ -n "$(git diff --name-only "$RANGE" -- engine/src/ 2>/dev/null)" ]; then
        ENGINE_SRC_CHANGED="yes"
        # Nutzer-Wunsch 2026-08-11: "bei aenderungen im logtext brauch ich keinen
        # engine cargo build check". Nicht ganz weglassen, sondern von TESTEN auf
        # KOMPILIEREN herabsetzen -- ein Logtext kann die Kompilierung sehr wohl
        # brechen (`format!("{name}")` mit fehlender Variable ist ein Fehler,
        # keine Warnung).
        #
        # KONSERVATIV: nur wenn JEDE geaenderte Zeile in engine/src/ eine
        # `log_event`-Zeile oder ein Kommentar ist. Bei jedem Zweifel bleibt es
        # beim vollen Test -- die Erkennung darf nie zu wenig pruefen.
        NICHT_LOG=$(git diff -U0 "$RANGE" -- engine/src/ 2>/dev/null             | grep -E '^[+-]' | grep -vE '^(\+\+\+|---)'             | grep -vE '^[+-][[:space:]]*(//|log_event|.*log_event\()'             | grep -vE '^[+-][[:space:]]*"' | head -1)
        if [ -z "$NICHT_LOG" ]; then
            NUR_LOGTEXT="yes"
        else
            NUR_LOGTEXT=""
        fi
    fi
done

if [ -z "$ENGINE_SRC_CHANGED" ]; then
    exit 0  # engine/src/ nicht betroffen -- sofort durchlassen
fi

# Python-DLL im PATH voranstellen, sonst STATUS_DLL_NOT_FOUND (siehe MEMORY
# "cargo test braucht Python-DLL im PATH"). Der Pfad ist maschinenabhaengig und
# steht deshalb NICHT mehr fest im Skript (Nutzer-Entscheid 2026-08-17: das Repo
# ist oeffentlich, es soll keine Rechnerstruktur enthalten).
#
# Reihenfolge: erst MOSAIC_PYTHON_DIR, sonst aus dem gefundenen python selbst
# ableiten. Nur falls beides scheitert, laeuft cargo ohne die DLL im PATH und
# bricht mit STATUS_DLL_NOT_FOUND ab -- dann MOSAIC_PYTHON_DIR setzen.
PYDIR="${MOSAIC_PYTHON_DIR:-}"
if [ -z "$PYDIR" ] && command -v python >/dev/null 2>&1; then
    PYDIR="$(python -c 'import sys,os; print(os.path.dirname(sys.executable))' 2>/dev/null)"
fi
if [ -n "$PYDIR" ]; then
    export PATH="$PYDIR:$PATH"
else
    echo "pre-push: WARNUNG -- Python-Verzeichnis nicht ermittelbar." >&2
    echo "          Bei STATUS_DLL_NOT_FOUND: MOSAIC_PYTHON_DIR setzen." >&2
fi

if [ -n "$NUR_LOGTEXT" ]; then
    echo "pre-push: engine/src/ nur in LOGTEXT/Kommentaren geaendert -- nur" >&2
    echo "          cargo build statt cargo test (Nutzer-Entscheid 2026-08-11)." >&2
    echo "          ACHTUNG: Logtexte sind hier NICHT harmlos -- die Regexes von" >&2
    echo "          tools/analyze_game_log.py haengen am Wortlaut. Wer eine" >&2
    echo "          log_event-Zeichenkette aendert, muss den Parser mitziehen." >&2
    (cd engine && cargo build --release --lib)
    STATUS=$?
    WAS="cargo build --release"
else
    echo "pre-push: engine/src/ im Push geaendert -- cargo test --release laeuft (Budget < 90 s)." >&2
    (cd engine && cargo test --release)
    STATUS=$?
    WAS="cargo test --release"
fi

if [ "$STATUS" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: $WAS rot -- Push abgebrochen." >&2
    echo "Ausweg: Fehler fixen, oder falls es ein Fehlalarm ist: git push --no-verify" >&2
fi

exit "$STATUS"
