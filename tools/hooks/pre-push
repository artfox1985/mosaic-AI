#!/bin/sh
# tools/hooks/pre-push -- Golden-Waechter (A1-A4, `cargo test --release`), aber
# NUR wenn im zu pushenden Bereich engine/src/ geaendert wurde. Andernfalls
# sofortiger Durchlass (Zeile "sonst durchlassen" im Design-Dok).
#
# Aktivierung (einmalig, siehe tools/hooks/README.md):
#   git config core.hooksPath tools/hooks
#
# Budget: < 90 s (siehe docs/DESIGN_conventions_as_checks.md,
# Abschnitt "Entscheid: LOKALER GIT-HOOK").
#
# Fehlalarm? git push --no-verify
#
# Git ruft pre-push mit ($1=Remote-Name, $2=Remote-URL) auf und liefert auf
# stdin eine Zeile je zu aktualisierender Ref: "<local ref> <local sha>
# <remote ref> <remote sha>".

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

ZERO_SHA="0000000000000000000000000000000000000000"
ENGINE_SRC_CHANGED=""
PRIVACY_HITS=""

# Rechnerstruktur-Waechter (CLAUDE.md, Abschnitt "Oeffentliches Repo: keine
# Rechnerstruktur", Nutzer-Entscheid 2026-08-17). Dort steht der Pruefbefehl
# bisher nur als HANDGRIFF vor dem Push -- ein Handgriff, den man vergisst.
#
# Das Muster steht bewusst NICHT mit einem konkreten Nutzernamen im Skript
# (das waere selbst der Verstoss, den es sucht). Stattdessen: generische
# Nutzerpfad-Formen plus der Name aus der UMGEBUNG.
#
# Zeichenklasse mit ZWEI Backslashes: `[\\/]` trifft Backslash ODER Slash.
# Mit einem escapt er nur den Schraegstrich und laesst jeden Windows-Pfad
# still stehen -- genau dieser Fehler ist am 2026-08-17 zweimal passiert.
# '+' statt genau einem Trenner: in JSON stehen Windows-Pfade mit DOPPELTEM
# Backslash (Form "D:\\Wolke\\Ordner\\..."; das echte Beispiel stuende hier
# selbst im Muster -- der Waechter hat sich am 2026-08-27 prompt in diesem
# Kommentar gefangen und einen Push geblockt). Das alte Muster erwartete genau
# einen und hat deshalb am 2026-08-27 einen getrackten -- und bereits
# gepushten -- absoluten Pfad samt Nutzernamen durchgelassen:
# models/frozen_heuristics/hv2_generator/golden_probe/manifest_probe_*.json
# (Verzeichnis am 2026-08-28 umbenannt, damals noch v2huelle_generator).
# Gegenprobe damals: altes Muster 0 Treffer, dieses 1.
PRIVACY_PAT='[A-Za-z]:[\\/]+Users[\\/]+|/[a-z]/Users/|OneDrive[\\/]+(Documents|Backups)'
PRIVACY_USER="${USERNAME:-${USER:-}}"
if [ -n "$PRIVACY_USER" ] && [ "${#PRIVACY_USER}" -ge 4 ]; then
    PRIVACY_PAT="$PRIVACY_PAT|$PRIVACY_USER"
fi

# CLAUDE.md ist ausgenommen: dort steht der Pruefbefehl selbst im Text, die
# Datei traefe sich also bei jedem Push selbst.
PRIVACY_SKIP='^CLAUDE\.md$'

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    if [ "$local_sha" = "$ZERO_SHA" ]; then
        continue  # Ref wird geloescht -- nichts zu pruefen
    fi
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        RANGE="$local_sha"  # neuer Remote-Branch: kompletten Branch pruefen
    else
        RANGE="$remote_sha..$local_sha"
    fi

    # --- Rechnerstruktur-Waechter (billig, laeuft IMMER -- auch wenn
    # engine/src/ nicht betroffen ist und der Haken unten sofort durchlaesst).
    #
    # Geprueft wird der GEPUSHTE Stand (git grep gegen $local_sha), nicht der
    # Working Tree: sonst meldet der Haken Dinge, die gar nicht rausgehen.
    # Nur hinzugefuegte/geaenderte Dateien -- die Historie wird laut CLAUDE.md
    # NICHT umgeschrieben, Alt-Treffer duerfen also nicht blockieren.
    # `< /dev/null` an den Kommandosubstitutionen: die erben sonst den stdin
    # der Schleife und koennten die noch ungelesenen Ref-Zeilen fressen.
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        PRIVACY_FILES=$(git ls-tree -r --name-only "$local_sha" \
                            2>/dev/null < /dev/null)
    else
        PRIVACY_FILES=$(git diff --name-only --diff-filter=ACMR \
                            "$remote_sha" "$local_sha" 2>/dev/null < /dev/null)
    fi
    PRIVACY_FILES=$(printf '%s\n' "$PRIVACY_FILES" | grep -vE "$PRIVACY_SKIP")

    # An `xargs` darf KEIN `< /dev/null` -- das kappt seine Eingabe, die
    # Dateiliste kaeme nie an und `--no-run-if-empty` liesse ihn still nichts
    # tun (Exit 0 = gruen). Genau so war dieser Waechter beim ersten Bau
    # entwaffnet, die Gegenprobe hat es gefangen. Der stdin der Schleife ist
    # hier schon durch die Pipe abgeschirmt.
    if [ -n "$PRIVACY_FILES" ]; then
        FOUND=$(printf '%s\n' "$PRIVACY_FILES" | tr '\n' '\0' \
                | xargs -0 --no-run-if-empty \
                  git grep -I -n -E -e "$PRIVACY_PAT" "$local_sha" -- \
                  2>/dev/null)
        [ -n "$FOUND" ] && PRIVACY_HITS="$PRIVACY_HITS$FOUND
"
    fi

    if [ -n "$(git diff --name-only "$RANGE" -- engine/src/ 2>/dev/null)" ]; then
        ENGINE_SRC_CHANGED="yes"
        # Nutzer-Wunsch 2026-08-11: "bei aenderungen im logtext brauch ich keinen
        # engine cargo build check". Nicht ganz weglassen, sondern von TESTEN auf
        # KOMPILIEREN herabsetzen -- ein Logtext kann die Kompilierung sehr wohl
        # brechen (`format!("{name}")` mit fehlender Variable ist ein Fehler,
        # keine Warnung).
        #
        # KONSERVATIV: nur wenn JEDE geaenderte Zeile in engine/src/ eine
        # `log_event`-Zeile oder ein Kommentar ist. Bei jedem Zweifel bleibt es
        # beim vollen Test -- die Erkennung darf nie zu wenig pruefen.
        NICHT_LOG=$(git diff -U0 "$RANGE" -- engine/src/ 2>/dev/null             | grep -E '^[+-]' | grep -vE '^(\+\+\+|---)'             | grep -vE '^[+-][[:space:]]*(//|log_event|.*log_event\()'             | grep -vE '^[+-][[:space:]]*"' | head -1)
        if [ -z "$NICHT_LOG" ]; then
            NUR_LOGTEXT="yes"
        else
            NUR_LOGTEXT=""
        fi
    fi
done

# Rechnerstruktur-Waechter zuerst auswerten: er gilt fuer JEDEN Push, nicht
# nur fuer engine/src/-Aenderungen.
if [ -n "$PRIVACY_HITS" ]; then
    echo "" >&2
    echo "pre-push: RECHNERSTRUKTUR in gepushten Dateien -- Push abgebrochen." >&2
    echo "Das Repo ist oeffentlich (CLAUDE.md, Nutzer-Entscheid 2026-08-17):" >&2
    echo "keine absoluten Pfade, kein Nutzername in neuen Dateien." >&2
    echo "" >&2
    printf '%s' "$PRIVACY_HITS" | sed 's/^/  /' >&2
    echo "" >&2
    echo "Ausweg: Pfad aus der Umgebung beziehen (Vorbilder: MOSAIC_PYTHON_DIR," >&2
    echo "MOSAIC_BACKUP_DIR, MOSAIC_MODELS_DIR), oder bei Fehlalarm:" >&2
    echo "git push --no-verify" >&2
    exit 1
fi

if [ -z "$ENGINE_SRC_CHANGED" ]; then
    exit 0  # engine/src/ nicht betroffen -- sofort durchlassen
fi

# Python-DLL im PATH voranstellen, sonst STATUS_DLL_NOT_FOUND (siehe MEMORY
# "cargo test braucht Python-DLL im PATH"). Der Pfad ist maschinenabhaengig und
# steht deshalb NICHT mehr fest im Skript (Nutzer-Entscheid 2026-08-17: das Repo
# ist oeffentlich, es soll keine Rechnerstruktur enthalten).
#
# Reihenfolge: erst MOSAIC_PYTHON_DIR, sonst aus dem gefundenen python selbst
# ableiten. Nur falls beides scheitert, laeuft cargo ohne die DLL im PATH und
# bricht mit STATUS_DLL_NOT_FOUND ab -- dann MOSAIC_PYTHON_DIR setzen.
#
# sys.base_prefix statt dirname(sys.executable): in einem venv liegt das
# Interpreter-Exe in venv/Scripts/, die python*.dll aber in der Basis-
# Installation.
PYDIR="${MOSAIC_PYTHON_DIR:-}"
if [ -z "$PYDIR" ] && command -v python >/dev/null 2>&1; then
    PYDIR="$(python -c 'import sys; print(sys.base_prefix)' 2>/dev/null)"
fi

# PATH ist hier ein :-getrennter POSIX-PATH. Ein Windows-Pfad mit Laufwerks-
# buchstabe zerfaellt darin am Doppelpunkt in zwei unbrauchbare Eintraege
# (Laufwerk und Rest) -- die DLL wird NICHT gefunden und cargo test stirbt mit
# STATUS_DLL_NOT_FOUND, obwohl das Verzeichnis korrekt ermittelt wurde. Genau
# dieser Fehlschlag ist am 2026-08-17 im Push aufgetreten. Deshalb umrechnen;
# ein bereits POSIX-formatierter Pfad bleibt von cygpath -u unberuehrt.
if [ -n "$PYDIR" ] && command -v cygpath >/dev/null 2>&1; then
    PYDIR="$(cygpath -u "$PYDIR" 2>/dev/null || printf '%s' "$PYDIR")"
fi

if [ -n "$PYDIR" ] && ls "$PYDIR"/python3*.dll >/dev/null 2>&1; then
    export PATH="$PYDIR:$PATH"
elif [ -n "$PYDIR" ]; then
    echo "pre-push: WARNUNG -- in '$PYDIR' liegt keine python3*.dll." >&2
    echo "          Bei STATUS_DLL_NOT_FOUND: MOSAIC_PYTHON_DIR auf das" >&2
    echo "          Verzeichnis mit python3.dll/python3XX.dll setzen." >&2
else
    echo "pre-push: WARNUNG -- Python-Verzeichnis nicht ermittelbar." >&2
    echo "          Bei STATUS_DLL_NOT_FOUND: MOSAIC_PYTHON_DIR setzen." >&2
fi

if [ -n "$NUR_LOGTEXT" ]; then
    echo "pre-push: engine/src/ nur in LOGTEXT/Kommentaren geaendert -- nur" >&2
    echo "          cargo build statt cargo test (Nutzer-Entscheid 2026-08-11)." >&2
    echo "          ACHTUNG: Logtexte sind hier NICHT harmlos -- die Regexes von" >&2
    echo "          tools/analyze_game_log.py haengen am Wortlaut. Wer eine" >&2
    echo "          log_event-Zeichenkette aendert, muss den Parser mitziehen." >&2
    (cd engine && cargo build --release --lib)
    STATUS=$?
    WAS="cargo build --release"
else
    echo "pre-push: engine/src/ im Push geaendert -- cargo test --release laeuft (Budget < 90 s)." >&2
    (cd engine && cargo test --release)
    STATUS=$?
    WAS="cargo test --release"
fi

if [ "$STATUS" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: $WAS rot -- Push abgebrochen." >&2
    echo "Ausweg: Fehler fixen, oder falls es ein Fehlalarm ist: git push --no-verify" >&2
fi

exit "$STATUS"
