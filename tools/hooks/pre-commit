#!/bin/sh
# tools/hooks/pre-commit -- ruft den Konventions-Linter (Baustein A5) auf.
#
# Aktivierung (einmalig, siehe tools/hooks/README.md):
#   git config core.hooksPath tools/hooks
#
# Budget: < 3 s (siehe docs/DESIGN_conventions_as_checks.md,
# Abschnitt "Entscheid: LOKALER GIT-HOOK"). Nur textnahe Pruefungen -- keine
# Compilierung, kein Netz, keine Korpus-Dateien.
#
# Fehlalarm? Dieser Haken ist ein Werkzeug gegen VERSEHEN, kein Zwang:
#   git commit --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1

PYTHON_BIN="python"
command -v python >/dev/null 2>&1 || PYTHON_BIN="python3"

"$PYTHON_BIN" tools/check_conventions.py --staged
STATUS=$?
# 2026-09-06 (Nutzer-Auftrag nach dem Test-Audit): reine Python-Tests ohne Wheel,
# Korpus oder Netz (tools/tests/test_*.py; Manifest-Flags, Reihen-Alter-Sonde,
# spec_add_field). Laufzeit unter einer Sekunde; rot blockiert wie Regel 2-7.
if [ "$STATUS" -eq 0 ]; then
    "$PYTHON_BIN" -X utf8 -m unittest discover -s tools/tests -p "test_*.py" -q
    STATUS=$?
    [ "$STATUS" -ne 0 ] && echo "pre-commit: Python-Tests (tools/tests) rot -- Commit abgebrochen." >&2
fi

if [ "$STATUS" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: Konventions-Check (A5) rot -- Commit abgebrochen. Details oben." >&2
    echo "Ausweg: Verstoss beheben, oder falls es ein Fehlalarm ist: git commit --no-verify" >&2
fi

exit "$STATUS"
