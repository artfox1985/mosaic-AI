# ==========================================
# Mosaic-AI - Git Ignore File
# ==========================================

# 1. Projekt-Spezifische Daten (WICHTIG!)
# Ignoriere Trainingsdaten und trainierte Modelle (zu groß für Git)
/data/
# Gewichte bleiben draussen -- ABER die Trainingsmanifeste werden verfolgt
# (Nutzer-Entscheid 2026-08-17). Grund: sie sind das einzige Protokoll darueber,
# WIE ein Checkpoint entstanden ist -- Fenster, Traegersatz, Epochenverlauf.
# Der Traeger-Befund vom 2026-08-16 (Korpus in sieben Laeufen policy-maskiert)
# war unter anderem deshalb so lange unsichtbar, weil sich zwei Laeufe nicht
# diffen liessen. 41 Dateien = 192 KB, das ist fuer git nichts.
# Die Verzeichnisform muss '/models/*' sein, NICHT '/models/': git kann eine
# Datei nicht wieder einschliessen, wenn ihr ELTERNVERZEICHNIS ausgeschlossen
# ist -- mit '/models/' waere die Negation unten wirkungslos.
/models/*
!/models/manifest_train_*.json

# --- Eingefrorene Artefakte (Nutzer-Entscheid 2026-08-26) --------------------
# Ein eingefrorener Champion oder Lehrer ist kein Modell, sondern ein
# vollstaendiger AGENT: Gewichte, Spec, Wheel, Manifest, Golden Probe. Er ist
# per Bauart NICHT rekonstruierbar -- Training ist stochastisch, und ein Wheel
# laesst sich nur nachbauen, wenn Commit UND sauberer Baum bekannt sind.
#
# Am 2026-08-26 hat genau diese Luecke den v22-Korpus-Erzeuger gekostet:
# Commit bekannt (dbf6a08), git_dirty true, Verhalten unwiederbringlich. Ein
# sauberer Build desselben Commits erzeugt Feld fuer Feld etwas anderes als
# der Korpus (PREREG_generator_drift.md par.1). Bei einem HEURISTIK-Freeze
# waere der Schaden groesser: dort steckt das Verhalten vollstaendig im Wheel,
# es gibt kein ONNX, das es mittraegt.
#
# Die Verzeichnisse muessen hier stehen, nicht nur die Dateimuster: git steigt
# nicht in ein ausgeschlossenes Verzeichnis hinab, um Ausnahmen zu suchen
# (dieselbe Falle, vor der der Kommentar zu '/models/*' oben warnt).
# '/models/*' trifft nur DIREKTE Kinder -- ist das Verzeichnis wieder drin,
# sind die Dateien darunter automatisch sichtbar.
!/models/frozen_champions/
!/models/frozen_heuristics/

# Ausgenommen bleibt, was ABLEITBAR ist: 'venv/' (Abschnitt 3 weiter unten)
# greift auch hier und haelt die 33 MB je Artefakt draussen -- sie entstehen
# aus dem Wheel neu. Die Wheel-Negation steht am Dateiende, sie muss NACH
# '*.whl' kommen.
/static/log
*.pkl
*.pth
*.pt

# Spielerprofile / Elo-Ratings (Nutzer-Feature 2026-08-02, player_profiles.py):
# lokaler Laufzeit-Zustand des Server-Games, kein Trainings-/Code-Artefakt --
# nicht versionieren (persoenliche Ratings je Installation).
/player_profiles.json.corrupt

# 2. Python Cache
# Diese Dateien generiert Python automatisch, sie gehören nicht ins Repo
__pycache__/
*.py[cod]
*$py.class

# 3. Virtuelle Umgebungen (Virtual Environments)
# Falls du mal ein lokales Environment anlegst
venv/
env/
.venv/
.env

# 4. Entwicklungsumgebungen (IDE)
# Ignoriere deine persönlichen Editor-Einstellungen
.vscode/
.idea/
*.swp
*.swo

# 5. Betriebssystem-Dateien
# Verhindert, dass unsichtbare Systemdateien hochgeladen werden
.DS_Store
Thumbs.db
Desktop.ini

# 6. Jupyter Notebook Checkpoints (Falls du später mal welche nutzt)
.ipynb_checkpoints/
# 6. Rust (PyO3-Crate unter engine/)
# Build-Artefakte nicht versionieren; Cargo.lock bleibt drin (reproduzierbare Builds).
/engine/target/
*.whl
*.pyd
*.xlsx

# Konsolen-Mitschnitte der Hintergrundlaeufe (Ergebnisse liegen strukturiert in evaluations/)
logs/

# 7. Release-Build (Task #96): PyInstaller-Output + gepackte Bundles.
# Wird per tools/build_release.py erzeugt, nicht versionieren (groß, reproduzierbar).
/dist/*
/build/
*.zip
# Getrackte Build-Quellen in dist/ bleiben trotz Ordner-Ignore versioniert:
!dist/mosaic_release.spec
!dist/run_mosaic.py
!dist/README_GAME.txt
data/altmess_90files/

# Roh-Arena-Ergebnisse mit Partie-Logs (Nutzer-Entscheid 2026-08-12).
# ANLASS: eine Nacht Rasterlaeufe erzeugte 57 Dateien / 43,7 MB, davon 27,2 MB
# schon in der Historie -- bei einer verwertbaren Fraktion von 1,8 %.
# `--log-games` bleibt noetig WAEHREND eines Laufs (die Plattenpunkte je
# Kriterium stehen nur im Log), aber danach genuegt die eingedampfte Form:
#   python -X utf8 tools/arena_compact.py --muster "<praefix>_*"
#   -> evaluations/arena_compact.jsonl (versioniert, ~200 Byte je Partie)
# Entscheidende Laeufe, die eine Vorregistrierung ausdruecklich als Beleg
# benennt, koennen weiter mit `git add -f` einzeln aufgenommen werden.
evaluations/paired_arena_env_*.json
!evaluations/arena_compact.jsonl

# git-crypt-Schluessel: bewusst UNGETRACKT im Repo (Nutzer 2026-08-13).
# Ohne diese Datei ist player_profiles.json nach frischem Klon unlesbar.
/git-crypt-key
scratchpad/
*.pdf
/evaluations/artifacts

# --- Wheels INNERHALB eingefrorener Artefakte (Nutzer-Entscheid 2026-08-26) ---
# '*.whl' oben schliesst Build-Artefakte aus, und das bleibt richtig. In einem
# eingefrorenen Artefakt ist das Wheel aber kein Build-Abfall, sondern der
# Traeger des Verhaltens. Diese Negation MUSS nach '*.whl' stehen: bei git
# gewinnt die zuletzt passende Regel.
!/models/frozen_champions/**/*.whl
!/models/frozen_heuristics/**/*.whl
